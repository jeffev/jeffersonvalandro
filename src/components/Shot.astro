---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A screenshot in a thin frame, or a neutral typographic placeholder when there is none.
interface Props {
  src?: ImageMetadata;
  alt: string;
  label?: string;
  sub?: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  fit?: 'cover' | 'contain';
  eager?: boolean;
}
const { src, alt, label, sub, ratio = '4 / 3', widths = [320, 480, 720, 960], sizes = '(max-width: 860px) 100vw, 320px', fit = 'cover', eager = false } = Astro.props;
---
<figure class:list={['shot', fit]} style={`aspect-ratio: ${ratio}`}>
  {src ? (
    <Image src={src} alt={alt} widths={widths.filter((w) => w <= src.width)} sizes={sizes} format="webp" quality={78} loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <div class="ph" role="img" aria-label={alt}>
      <span class="mono">{sub}</span>
      <strong>{label}</strong>
    </div>
  )}
</figure>

<style>
  .shot { border: 1px solid var(--line); background: var(--bg); overflow: hidden; }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .shot.contain :global(img) { object-fit: contain; background: #fff; }
  .ph {
    height: 100%; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; padding: 18px;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 16px 16px; background-color: var(--paper);
  }
  .ph strong { font-size: 20px; letter-spacing: -0.02em; line-height: 1.15; background: var(--paper); align-self: flex-start; padding: 2px 6px; border: 1px solid var(--line); }
  .ph .mono { background: var(--paper); align-self: flex-start; padding: 1px 6px; }
</style>
