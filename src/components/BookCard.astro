---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { productImage } from '../lib/images';
import { useT, type Lang } from '../i18n';

interface Props { book: CollectionEntry<'books'>; lang: Lang }
const { book, lang } = Astro.props;
const b = book.data;
const tr = useT(lang);
const cover = productImage(b.image);
---
<article class="book">
  <Image src={cover} alt="" widths={[160, 280]} sizes="140px" format="webp" quality={80} loading="lazy" />
  <div>
    <h3>{b.title}</h3>
    <p>{b.description[lang]}{b.pages && <span class="mono"> · {b.pages} {tr('books.pages')}</span>}</p>
    <div class="links">
      {b.soon && <span class="mono soon">{tr('books.soon')}</span>}
      {b.links?.map((l) => (
        <a href={l.url} target={l.kind === 'amazon' ? '_blank' : undefined} rel={l.kind === 'amazon' ? 'noopener' : undefined} download={l.kind !== 'amazon' ? '' : undefined}>
          {l.label ? l.label[lang] : l.kind === 'pdf' ? tr('books.pdf') : 'Amazon'}
          {l.price && <span class="price">{l.price}</span>}
          <Icon name={l.kind === 'amazon' ? 'external' : 'download'} size={13} />
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .book { background: var(--paper); padding: 20px; display: grid; grid-template-columns: 112px 1fr; gap: 18px; align-items: start; }
  .book :global(img) { width: 112px; height: 112px; object-fit: cover; border: 1px solid var(--line); }
  h3 { font-size: 17px; line-height: 1.3; letter-spacing: -0.01em; }
  p { color: var(--muted); font-size: 14.5px; margin: 6px 0 10px; }
  p .mono { font-size: 12px; }
  .soon { border: 1px dashed var(--line); padding: 2px 8px; }
  .price { color: var(--ink); font-weight: 700; margin-left: 4px; }
  @media (max-width: 480px) { .book { grid-template-columns: 84px 1fr; gap: 14px; } .book :global(img) { width: 84px; height: 84px; } }
</style>
