---
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n';
import profile from '../data/profile.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = useT(lang);
// The address never appears in the HTML as text: it is assembled in the browser on click.
const encoded = [...Buffer.from(['jeffev123', 'gmail.com'].join('@')).toString('base64')].reverse().join('');
---
<footer class="wrap">
  <div class="cta" id="contato">
    <div>
      <h2>{tr('cta.title')}</h2>
      <p>{tr('cta.lead')}</p>
    </div>
    <div class="actions">
      <button type="button" class="btn accent email" data-e={encoded} data-copied={tr('cta.copied')}>
        <Icon name="mail" /> <span>{tr('cta.email')}</span>
      </button>
      <div class="social">
        <a href={profile.links.linkedin} rel="me noopener" target="_blank"><Icon name="linkedin" size={18} label="LinkedIn" /></a>
        <a href={profile.links.github} rel="me noopener" target="_blank"><Icon name="github" size={18} label="GitHub" /></a>
        <a href={profile.links.kaggle} rel="me noopener" target="_blank"><Icon name="kaggle" size={18} label="Kaggle" /></a>
        <a href={profile.links.coffee} rel="noopener" target="_blank" title={tr('coffee.label')}><Icon name="coffee" size={18} label={tr('coffee.label')} /></a>
      </div>
    </div>
  </div>
  <p class="mono legal">© {new Date().getFullYear()} Jefferson Valandro</p>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.email').forEach((btn) => {
    btn.addEventListener('click', () => {
      const addr = atob([...(btn.dataset.e ?? '')].reverse().join(''));
      const link = document.createElement('a');
      link.href = `mailto:${addr}`;
      link.className = btn.className;
      link.textContent = addr;
      btn.replaceWith(link);
      navigator.clipboard?.writeText(addr).then(
        () => { link.title = btn.dataset.copied ?? ''; },
        () => {},
      );
    });
  });
</script>

<style>
  footer { margin: 80px auto 40px; }
  .cta { background: var(--ink); color: var(--paper); padding: 40px; display: flex; justify-content: space-between; align-items: center; gap: 28px; }
  .cta h2 { font-size: clamp(28px, 4vw, 40px); line-height: 1.1; letter-spacing: -0.02em; }
  .cta p { color: color-mix(in srgb, var(--paper) 72%, var(--ink)); margin-top: 8px; }
  .actions { display: flex; flex-direction: column; align-items: flex-end; gap: 16px; }
  .actions :global(.btn) { border: 0; }
  .social { display: flex; gap: 16px; }
  .social a:hover { color: var(--accent); }
  .legal { margin-top: 18px; }
  @media (max-width: 760px) {
    .cta { flex-direction: column; align-items: flex-start; padding: 28px 20px; }
    .actions { align-items: flex-start; }
  }
  @media print { footer { display: none; } }
</style>
