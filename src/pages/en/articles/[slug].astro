---
import View from '../../../views/Article.astro';
import { articlesFor, type Article } from '../../../lib/articles';

export async function getStaticPaths() {
  return (await articlesFor('en')).map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}
const { article } = Astro.props as { article: Article };
---
<View article={article} lang="en" />
