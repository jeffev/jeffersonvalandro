---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectItem from '../components/ProjectItem.astro';
import Icon from '../components/Icon.astro';
import Shot from '../components/Shot.astro';
import me from '../assets/me.jpg';
import profile from '../data/profile.json';
import { productImage } from '../lib/images';
import { articlesFor, readingMinutes } from '../lib/articles';
import { articleUrl, routes, useT, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = useT(lang);

const projects = await getCollection('projects');
const featured = projects.filter((p) => p.data.featured).sort((a, b) => a.data.featured! - b.data.featured!);
const products = await getCollection('products');
const bundles = (await getCollection('bundles')).sort((a, b) => a.data.order - b.data.order);
const books = await getCollection('books');
const flagship = books.find((b) => b.id === 'ia-por-dentro')!;

// Home shows a fixed pick across the four themes, in this order.
const picks = ['o-que-a-ia-nao-faz', 'spec-driven-com-ia', 'arquitetura-hexagonal-spring', 'mcp-para-empresas'];
const articles = (await articlesFor(lang)).filter((a) => picks.includes(a.id.split('/')[1]))
  .sort((a, b) => picks.indexOf(a.id.split('/')[1]) - picks.indexOf(b.id.split('/')[1]));

const stats = [
  { n: '10+', label: tr('stats.years') },
  { n: String(products.length), label: tr('stats.templates') },
  { n: String(profile.apifyActors), label: tr('stats.apify') },
  { n: String(books.length), label: tr('stats.books') },
];
---
<Base lang={lang} alternates={routes.home} current="home">
  <div class="wrap">
    <section class="hero panel">
      <div class="main">
        <span class="mono">{tr('hero.kicker')}</span>
        <h1>{tr('hero.title1')}<br />{tr('hero.title2')}<span class="hl">{tr('hero.title3')}</span></h1>
        <p class="lead">{tr('hero.lead')}</p>
        <nav class="paths" aria-label={tr('nav.menu')}>
          <a href="#contato"><span class="mono">01</span>{tr('hero.path1')}</a>
          <a href={routes.products[lang]}><span class="mono">02</span>{tr('hero.path2')}</a>
          <a href={routes.articles[lang]}><span class="mono">03</span>{tr('hero.path3')}</a>
        </nav>
      </div>
      <aside class="side">
        <Image src={me} alt="Jefferson Valandro" widths={[340, 520, 680]} sizes="(max-width: 860px) 100vw, 340px" format="webp" quality={80} loading="eager" fetchpriority="high" />
        <dl class="spec mono">
          <div><dt>{tr('spec.status')}</dt><dd class="ok">● {tr('spec.statusVal')}</dd></div>
          <div><dt>{tr('spec.stack')}</dt><dd>Java · Spring · React</dd></div>
          <div><dt>{tr('spec.now')}</dt><dd>{tr('spec.nowVal')}</dd></div>
          <div><dt>{tr('spec.base')}</dt><dd>{tr('spec.baseVal')}</dd></div>
        </dl>
      </aside>
    </section>

    <section class="block">
      <div class="head"><h2>{tr('home.projects')}</h2><a class="mono" href={routes.projects[lang]}>{tr('home.allProjects')} ({projects.length}) →</a></div>
      <div class="grid">
        {featured.map((p, i) => <ProjectItem project={p} lang={lang} eager={i < 2} />)}
      </div>
    </section>

    <section class="block">
      <ul class="stats">
        {stats.map((s) => <li class="panel"><strong>{s.n}</strong><span>{s.label}</span></li>)}
      </ul>
    </section>

    <section class="block">
      <div class="head"><h2>{tr('home.products')}</h2><a class="mono" href={routes.products[lang]}>{tr('home.store')} →</a></div>
      <div class="prod">
        {bundles.map((b) => (
          <a class="panel" href={routes.products[lang]}>
            <Shot src={productImage(b.data.image)} alt={b.data.name} ratio="16 / 9" widths={[400, 640, 800]} sizes="(max-width: 860px) 100vw, 380px" />
            <div><span>{b.data.name} <span class="mono">· {b.data.includes.length} templates</span></span><b>US$ {b.data.price.personal}</b></div>
          </a>
        ))}
        <a class="panel" href={routes.books[lang]}>
          <Shot src={productImage(flagship.data.image)} alt={flagship.data.title} ratio="16 / 9" widths={[400, 560]} sizes="(max-width: 860px) 100vw, 380px" />
          <div><span>{flagship.data.title}</span><b>Kindle</b></div>
        </a>
      </div>
    </section>

    <section class="block">
      <div class="head"><h2>{tr('home.articles')}</h2><a class="mono" href={routes.articles[lang]}>{tr('home.allArticles')} →</a></div>
      <ol class="arts">
        {articles.map((a, i) => (
          <li>
            <a href={articleUrl(lang, a.data.slug)}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{a.data.title}</span>
              <span class="mono meta">{tr(`theme.${a.data.theme}`)} · {readingMinutes(a.body)} {tr('articles.min')}</span>
              <Icon name="arrow" />
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr 340px; margin-top: 40px; }
  .main { padding: 56px 48px; border-right: 1px solid var(--line); }
  h1 { font-size: clamp(38px, 5.4vw, 68px); line-height: 1.02; letter-spacing: -0.035em; font-weight: 700; margin: 18px 0 24px; }
  .hl { color: var(--accent); }
  .lead { font-size: 19px; color: var(--muted); max-width: 600px; }
  .paths { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 40px; border: 1px solid var(--line); }
  .paths a { padding: 14px 18px; border-right: 1px solid var(--line); font-weight: 500; }
  .paths a:last-child { border-right: 0; }
  .paths a:first-child { background: var(--ink); color: var(--paper); }
  .paths a:first-child .mono { color: inherit; opacity: 0.7; }
  .paths a:not(:first-child):hover { background: var(--bg); }
  .paths .mono { display: block; }
  .side :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: 50% 30%; height: auto; border-bottom: 1px solid var(--line); }
  .spec { padding: 18px 22px; }
  .spec div { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px dashed var(--line); }
  .spec div:last-child { border: 0; }
  .spec dd { color: var(--ink); text-align: right; }
  .spec dd.ok { color: var(--ok); }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .stats li { border: 0; padding: 22px; }
  .stats strong { display: block; font-size: 40px; letter-spacing: -0.03em; line-height: 1.1; }
  .stats span { color: var(--muted); font-size: 14px; }

  .prod { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .prod a { display: flex; flex-direction: column; }
  .prod a :global(.shot) { border: 0; border-bottom: 1px solid var(--line); }
  .prod a > div { padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .prod b { color: var(--accent); white-space: nowrap; }
  .prod a:hover { border-color: var(--ink); }

  .arts { list-style: none; border-top: 1px solid var(--line); }
  .arts a { display: grid; grid-template-columns: 40px 1fr auto 20px; gap: 16px; align-items: baseline; padding: 18px 4px; border-bottom: 1px solid var(--line); }
  .arts .t { font-size: 19px; font-weight: 500; letter-spacing: -0.01em; }
  .arts a:hover .t { color: var(--accent); }
  .arts :global(svg) { align-self: center; color: var(--muted); }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .main { border-right: 0; border-bottom: 1px solid var(--line); padding: 32px 20px; }
    .side { display: grid; grid-template-columns: 120px 1fr; }
    .side :global(img) { border-bottom: 0; border-right: 1px solid var(--line); height: 100%; }
    .spec { padding: 10px 14px; font-size: 11.5px; }
    .paths { grid-template-columns: 1fr; }
    .paths a { border-right: 0; border-bottom: 1px solid var(--line); }
    .paths a:last-child { border-bottom: 0; }
    .grid, .prod { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr 1fr; }
    .arts a { grid-template-columns: 28px 1fr; }
    .arts .meta { grid-column: 2; }
    .arts :global(svg) { display: none; }
  }
</style>
