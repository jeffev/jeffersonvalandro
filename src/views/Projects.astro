---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { routes, useT, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = useT(lang);
const all = await getCollection('projects'); // file order = display order
const isData = (id: string) => ['ipca', 'fraud', 'house', 'invest-compare'].includes(id);
const groups = [
  { title: tr('projects.featured'), items: all.filter((p) => p.data.featured).sort((a, b) => a.data.featured! - b.data.featured!) },
  { title: tr('projects.tools'), items: all.filter((p) => !p.data.featured && !isData(p.id)) },
  { title: tr('projects.data'), items: all.filter((p) => isData(p.id)) },
];
---
<Base lang={lang} title={tr('projects.title')} description={tr('projects.lead')} alternates={routes.projects} current="projects">
  <div class="wrap">
    <header class="page-title panel">
      <span class="mono">/{tr('nav.projects')} · {all.length}</span>
      <h1>{tr('projects.title')}</h1>
      <p>{tr('projects.lead')}</p>
    </header>
    {groups.map((g, gi) => (
      <section class="block">
        <div class="head"><h2>{g.title}</h2><span class="mono">{g.items.length}</span></div>
        <div class="list">
          {g.items.map((p, i) => <ProjectItem project={p} lang={lang} full eager={gi === 0 && i < 2} />)}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .list { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
</style>
